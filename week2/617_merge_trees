class Solution:              # 声明类 Solution 
    def mergeTrees(self, root1: Optional[TreeNode], root2: Optional[TreeNode]) -> Optional[TreeNode]:   # 定义函数mergeTrees 固定写法，类中的函数必须加入self！
        if not root1:        # 如果root1为空，返回root2
            return root2
        if not root2:        
            return root1
                             # root1.val 提取出root1中对应节点的值并储存在原位置
        root1.val += root2.val  # 对应节点数值相加

        root1.left = self.mergeTrees(root1.left , root2.left)
        root1.right = self.mergeTrees(root1.right , root2.right)

        return root1
